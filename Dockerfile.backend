FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRANSFORMERS_NO_TF=1 \
    USE_TF=0 \
    TF_ENABLE_ONEDNN_OPTS=0 \
    TF_CPP_MIN_LOG_LEVEL=3

WORKDIR /app

# Install system dependencies for OpenCV and image operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY DTI-Backend/requirements.txt /app/DTI-Backend/requirements.txt
RUN pip install --no-cache-dir -r /app/DTI-Backend/requirements.txt \
    tensorflow \
    opencv-python-headless \
    scipy \
    pillow \
    requests

# Copy project files
COPY DTI-Backend /app/DTI-Backend
COPY "Image Detection" "/app/Image Detection"
COPY research /app/research

WORKDIR /app/DTI-Backend

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

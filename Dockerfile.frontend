# Stage 1: Build React/Vite SPA
FROM node:22-alpine AS builder

WORKDIR /app

# Cache dependencies
COPY DTI-frontend/headline-verifier/package*.json ./
RUN npm ci

# Copy application source
COPY DTI-frontend/headline-verifier/ ./

ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

# Stage 2: Serve with lightweight Nginx reverse proxy
FROM nginx:alpine

# Copy built static artifacts
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom reverse proxy & security configuration
COPY DTI-frontend/headline-verifier/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
